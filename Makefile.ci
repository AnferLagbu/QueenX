# QueenX CI Local Targets
#
# Usage:
#   make -f Makefile.ci ci              # Full CI flow
#   make -f Makefile.ci ci-audit        # SAFETY + boundary + deadlock audit
#   make -f Makefile.ci ci-cargo        # cargo check (x86_64 + aarch64)
#   make -f Makefile.ci ci-unsafe-scan  # services 0-unsafe scan
#   make -f Makefile.ci ci-bench        # framekernel-bench + 回归检查
#   make -f Makefile.ci ci-bench-record # 重新记录性能基线
#   make -f Makefile.ci ci-test-host    # host-tests (单元 + 集成) 全量测试
#   make -f Makefile.ci ci-fix          # auto-fix where possible

LOG_DIR := build/log
PY := python3

.PHONY: ci ci-audit ci-cargo ci-unsafe-scan ci-bench ci-bench-record ci-test-host ci-fix ci-clean help

help:
	@echo "QueenX CI Targets"
	@echo ""
	@echo "  make -f Makefile.ci ci                - Full CI flow"
	@echo "  make -f Makefile.ci ci-audit          - SAFETY + boundary + deadlock audit"
	@echo "  make -f Makefile.ci ci-cargo          - cargo check (x86_64 + aarch64)"
	@echo "  make -f Makefile.ci ci-unsafe-scan    - services 0-unsafe scan"
	@echo "  make -f Makefile.ci ci-bench          - framekernel-bench + 回归检查"
	@echo "  make -f Makefile.ci ci-bench-record   - 重新记录性能基线"
	@echo "  make -f Makefile.ci ci-test-host      - host-tests 单元+集成全量 (Cargo 自动发现)"
	@echo "  make -f Makefile.ci ci-test-aarch64   - aarch64 QEMU boot test"
	@echo "  make -f Makefile.ci ci-fix            - auto-fix where possible"
	@echo "  make -f Makefile.ci ci-clean          - clean log dir"
	@echo ""

# Full CI
ci: ci-unsafe-scan ci-audit ci-cargo ci-bench ci-test-aarch64
	@echo ""
	@echo "=========================================="
	@echo "QueenX Framekernel Compliance: PASS"
	@echo "=========================================="

# Unsafe scan (uses Python script for accurate comment filtering)
ci-unsafe-scan:
	@echo "[1/3] services 0-unsafe scan..."
	@mkdir -p $(LOG_DIR)
	@$(PY) scripts/ci_check_services_unsafe.py

# Audit
ci-audit:
	@echo "[2/4] SAFETY + boundary + deadlock audit..."
	@mkdir -p $(LOG_DIR)
	@echo "  - SAFETY comment audit (M6.1)..."
	@$(PY) scripts/audit_safety_coverage.py > $(LOG_DIR)/safety_audit.txt 2>&1
	@echo "  - services->framework boundary (M6.3)..."
	@$(PY) scripts/audit_services_boundary.py > $(LOG_DIR)/services_boundary.txt 2>&1
	@echo "  - deadlock matrix (M6.2)..."
	@$(PY) scripts/audit_deadlock_matrix.py > $(LOG_DIR)/deadlock_matrix.txt 2>&1
	@if grep -q "CRITICAL" $(LOG_DIR)/deadlock_matrix.txt; then \
		echo "FAIL: deadlock matrix CRITICAL" ; \
		head -50 $(LOG_DIR)/deadlock_matrix.txt ; \
		exit 1 ; \
	fi
	@echo "PASS: all audits pass"

# Cargo check
ci-cargo:
	@echo "[3/3] cargo check (x86_64 + aarch64)..."
	@mkdir -p $(LOG_DIR)
	@cd src/rust && cargo check --target x86_64-unknown-none 2>&1 | tee ../../$(LOG_DIR)/cargo_check_x86_64.txt
	@cd src/rust && cargo check --target aarch64-unknown-none-softfloat 2>&1 | tee ../../$(LOG_DIR)/cargo_check_aarch64.txt
	@if grep -q "^error\[" $(LOG_DIR)/cargo_check_x86_64.txt $(LOG_DIR)/cargo_check_aarch64.txt 2>/dev/null; then \
		echo "FAIL: cargo check failed" ; \
		exit 1 ; \
	fi
	@echo "PASS: cargo check"

# Auto-fix
ci-fix:
	@echo "Running auto-fix..."
	@echo "  - cargo fix --allow-dirty"
	@cd src/rust && cargo fix --target x86_64-unknown-none --allow-dirty --allow-staged 2>&1 | tail -10 || true
	@echo "PASS: auto-fix complete (please re-run make ci)"

# Bench: 运行 framekernel-bench 并做 15% 回归检查
ci-bench:
	@echo "[4/4] framekernel-bench + 回归检查 (M6.9)..."
	@mkdir -p $(LOG_DIR)
	@if [ ! -f host-tests/benches/baseline.json ]; then \
		echo "  - baseline.json 不存在, 自动记录初始基线..." ; \
		$(PY) scripts/record_bench_baseline.py > $(LOG_DIR)/bench_baseline_init.txt 2>&1 ; \
		echo "  - 已生成 baseline.json, 后续将进入回归检查模式" ; \
	fi
	@echo "  - 运行回归检查..."
	@$(PY) scripts/check_bench_regression.py > $(LOG_DIR)/bench_regression.txt 2>&1 || \
		( echo "FAIL: bench 回归检查失败, 见 $(LOG_DIR)/bench_regression.txt" ; \
		  cat $(LOG_DIR)/bench_regression.txt ; \
		  exit 1 )
	@echo "PASS: bench 回归检查通过"

# Bench record: 主动重新记录基线
ci-bench-record:
	@echo "[bench] 重新记录性能基线..."
	@mkdir -p $(LOG_DIR)
	@$(PY) scripts/record_bench_baseline.py | tee $(LOG_DIR)/bench_baseline.txt
	@echo "PASS: baseline.json 已更新"

# Host-tests: 单元 (内联 #[cfg(test)]) + 集成 (tests/ 自动发现)
# v2.24 重构后, 不再使用 [[test]] 显式声明, 全部由 Cargo 自动发现, 避免双重编译.
# 测试分布:
#   - 单元测试: src/{buddy,capability,checksum,sha256,dma_stream,framekernel_bench,nestfs_mock}.rs
#   - 集成测试: tests/{display,e1000_eeprom,iomem_alias,nestfs_test,nestfs_persist,stress_test}.rs
#   - 共享helper: tests/common/mod.rs
ci-test-host:
	@echo "[host-tests] 单元 + 集成测试 (Cargo 自动发现)..."
	@mkdir -p $(LOG_DIR)
	@cd host-tests && { cargo test --quiet > ../$(LOG_DIR)/host_tests.txt 2>&1; status=$$?; cat ../$(LOG_DIR)/host_tests.txt; exit $$status; }
	@echo "PASS: host-tests 全量通过"

# Clean
ci-clean:
	@rm -rf $(LOG_DIR)
	@echo "PASS: clean"

# aarch64 QEMU boot test
ci-test-aarch64:
	@echo "[aarch64] QEMU boot test..."
	@mkdir -p $(LOG_DIR)
	@bash scripts/qemu_boot_test.sh aarch64 2>&1 | tee $(LOG_DIR)/qemu_boot_aarch64.txt
	@echo "PASS: aarch64 QEMU boot test"
